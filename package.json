{
  "name": "kgsilkscreen",
  "version": "0.1.0",
  "private": true,
  "description": "كمال جادو — سلك سكرين | Landing page + 3 scroll-journey concept prototypes (Arabic RTL, Egyptian market)",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node --watch server.js",
    "export": "node scripts/export-static.js",
    "test": "node scripts/smoke.js",
    "seo": "node scripts/inject-jsonld.js",
    "build": "node scripts/ssg.js && node scripts/inject-jsonld.js && node scripts/export-static.js",
    "images": "node scripts/build-images.js",
    "og": "python3 scripts/og-image.py",
    "assets": "node scripts/build-images.js && node scripts/og-image.js",
    "ssg": "node scripts/ssg.js",
    "check": "node scripts/check-assets.js",
    "lint": "node scripts/lint-shaders.js",
    "verify": "node scripts/check-logo.js && node scripts/check-mobile.js && node scripts/lint-shaders.js && node scripts/smoke.js && node scripts/check-assets.js",
    "budget": "node scripts/budget.js",
    "css": "node scripts/minify-css.js",
    "fonts": "node scripts/build-fonts.js",
    "logo": "node scripts/logo-mark.js && node scripts/logo-lockup.js && node scripts/inline-brand.js",
    "check:logo": "node scripts/check-logo.js",
    "check:mobile": "node scripts/check-mobile.js",
    "test:hero": "node scripts/test-hero.js",
    "brand": "node scripts/inline-brand.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@fontsource/alexandria": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "jsdom": "^24.1.3"
  }
}
