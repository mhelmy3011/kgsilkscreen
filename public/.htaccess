# ===========================================================================
#  kgsilkscreen.store — Hostinger (Apache / LiteSpeed shared hosting)
# ===========================================================================
#  Everything here is something the Express server does for you locally. On
#  shared hosting there is no server.js in the request path, so these have to
#  be declared, or the site silently loses compression, caching and its 404.
#
#  Order matters: compression and caching first, then routing, then security
#  headers, then MIME types (bad types break overrides declared earlier).
# ===========================================================================

Options -Indexes

# ---------------------------------------------------------------------------
# 1. Compression — the single biggest win on the wire
#    The document is ~70 KB of HTML; brotli/gzip brings it to ~17 KB. Without
#    this block a 3G visitor downloads 4x more bytes than they need.
# ---------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# ---------------------------------------------------------------------------
# 2. Caching
#    Hashed/immutable assets can be cached for a year; HTML must not be, or
#    the owner edits a price and nobody sees it.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|avif|webp|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # -------------------------------------------------------------------------
  # 3. Security headers
  # -------------------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # The page needs inline critical CSS and inline JSON-LD, hence 'unsafe-inline'
  # for styles and no nonce; everything else is locked to self.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ---------------------------------------------------------------------------
# 4. MIME types — shared hosts often lack AVIF, and a wrong type is exactly
#    how images break silently.
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddCharset UTF-8 .html .css .js .json .svg .xml .webmanifest
</IfModule>

# ---------------------------------------------------------------------------
# 5. Routing
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # force https + strip www (one canonical host for SEO)
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # /index.html → / (never two URLs for the same content)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [L,R=301]

  # serve folder index files, then the 404 page
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>

ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# 6. Don't serve the source files that only the build needs
# ---------------------------------------------------------------------------
<FilesMatch "^(package|package-lock)\.json$|^\.env|^\.git">
  Require all denied
</FilesMatch>
